# Copy to .env.local (never commit .env.local). Restart `npm run dev` after edits.
# Use http://localhost:3000, not a 192.168.x.x address.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Server-only. Used by lib/supabase/admin.ts (admin dashboard). Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your_secret_or_service_role_key
